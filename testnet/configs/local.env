# Local Development Configuration
# For local cardano-node setup (useful for rapid iteration)

# Network Configuration
NETWORK_NAME=local
TESTNET_MAGIC=42
CARDANO_NODE_SOCKET_PATH=/tmp/cardano-node-local.socket

# Local Node Configuration
LOCAL_NODE_PORT=3001
LOCAL_NODE_CONFIG=/path/to/local/node/config

# Transaction Parameters
DEFAULT_COLLATERAL_AMOUNT=5000000
DEFAULT_TEST_AMOUNT=10000000
MIN_UTXO=1000000

# Fast Local Testing
TX_TIMEOUT=60
MAX_RETRIES=2
WAIT_BETWEEN_RETRIES=2

# Deployment Validation
REQUIRE_SCRIPT_VALIDATION=true
REQUIRE_DATUM_VALIDATION=true
REQUIRE_REDEEMER_VALIDATION=false

# Logging
LOG_LEVEL=DEBUG
LOG_FILE=/home/jimmyb/aiken/testnet/logs/local-deployment.log



