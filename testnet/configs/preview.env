# Preview Testnet Configuration  
# Cardano Preview testnet for quick testing and development

# Network Configuration
NETWORK_NAME=preview
TESTNET_MAGIC=2
CARDANO_NODE_SOCKET_PATH=/tmp/cardano-node.socket

# Blockfrost Configuration
BLOCKFROST_URL=https://cardano-preview.blockfrost.io/api/v0
BLOCKFROST_PROJECT_ID=preview_your_project_id_here

# Transaction Parameters
DEFAULT_COLLATERAL_AMOUNT=5000000
DEFAULT_TEST_AMOUNT=10000000
MIN_UTXO=1000000

# Timeout and Retry Configuration
TX_TIMEOUT=180
MAX_RETRIES=5
WAIT_BETWEEN_RETRIES=5

# Deployment Validation
REQUIRE_SCRIPT_VALIDATION=true
REQUIRE_DATUM_VALIDATION=true
REQUIRE_REDEEMER_VALIDATION=true

# Logging
LOG_LEVEL=DEBUG
LOG_FILE=/home/jimmyb/aiken/testnet/logs/preview-deployment.log



