# Preprod Testnet Configuration
# Official Cardano Preprod testnet for pre-production testing

# Network Configuration
NETWORK_NAME=preprod
TESTNET_MAGIC=1097911063
CARDANO_NODE_SOCKET_PATH=/tmp/cardano-node.socket

# Blockfrost Configuration
BLOCKFROST_URL=https://cardano-preprod.blockfrost.io/api/v0
BLOCKFROST_PROJECT_ID=preprodb51DvdEdGkJgVmx1CNnR2EEfWrDtifLR

# Transaction Parameters
DEFAULT_COLLATERAL_AMOUNT=5000000
DEFAULT_TEST_AMOUNT=10000000
MIN_UTXO=1000000

# Timeout and Retry Configuration
TX_TIMEOUT=300
MAX_RETRIES=3
WAIT_BETWEEN_RETRIES=10

# Deployment Validation
REQUIRE_SCRIPT_VALIDATION=true
REQUIRE_DATUM_VALIDATION=true
REQUIRE_REDEEMER_VALIDATION=true

# Logging
LOG_LEVEL=INFO
LOG_FILE=/home/jimmyb/aiken/testnet/logs/preprod-deployment.log
